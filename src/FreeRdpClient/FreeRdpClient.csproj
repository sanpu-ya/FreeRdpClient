<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FreeRdpClient</RootNamespace>
    <AssemblyName>FreeRdpClient</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- FreeRDP binaries (FreeRDP/build/install/bin) and the bridge DLL (native/FreeRdpBridge/build) -->
    <FreeRdpBinDir Condition="'$(FreeRdpBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\FreeRDP\build\install\bin\</FreeRdpBinDir>
    <FreeRdpBridgeDir Condition="'$(FreeRdpBridgeDir)' == ''">$(MSBuildThisFileDirectory)..\..\native\FreeRdpBridge\build\</FreeRdpBridgeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeRdp.Interop\FreeRdp.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native runtime: FreeRDP DLLs (without the SDL client dependencies) + FreeRdpBridge.dll -->
  <ItemGroup>
    <NativeRuntime Include="$(FreeRdpBinDir)*.dll" Exclude="$(FreeRdpBinDir)SDL3*.dll" />
    <NativeRuntime Include="$(FreeRdpBridgeDir)FreeRdpBridge.dll" />
    <None Include="@(NativeRuntime)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="CheckNativeRuntime" BeforeTargets="Build">
    <Error Condition="!Exists('$(FreeRdpBridgeDir)FreeRdpBridge.dll')"
           Text="FreeRdpBridge.dll not found in $(FreeRdpBridgeDir). Run native\FreeRdpBridge\build.cmd first." />
    <Error Condition="!Exists('$(FreeRdpBinDir)freerdp3.dll')"
           Text="FreeRDP binaries not found in $(FreeRdpBinDir). Build/install FreeRDP or set FreeRdpBinDir." />
  </Target>

</Project>
