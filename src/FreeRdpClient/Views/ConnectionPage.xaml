<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FreeRdpClient.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FreeRdpClient.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1040" Padding="24,24,24,32" ColumnSpacing="32" RowSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                <Image Source="ms-appx:///Assets/AppLogo.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="リモート デスクトップ接続" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Connection form -->
            <StackPanel Grid.Row="1" Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" Header="コンピューター" PlaceholderText="ホスト名または IP アドレス"
                             KeyDown="OnFormKeyDown" TextChanged="OnHostChanged" />
                    <NumberBox x:Name="PortBox" Grid.Column="1" Header="ポート" Value="3389" Minimum="1" Maximum="65535"
                               SpinButtonPlacementMode="Hidden" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UserBox" Header="ユーザー名" PlaceholderText="user または DOMAIN\user" KeyDown="OnFormKeyDown" />
                    <TextBox x:Name="DomainBox" Grid.Column="1" Header="ドメイン (省略可)" KeyDown="OnFormKeyDown" />
                </Grid>

                <PasswordBox x:Name="PasswordBox" Header="パスワード (空欄の場合は接続時に入力)" KeyDown="OnFormKeyDown" />
                <CheckBox x:Name="SavePasswordBox" Content="パスワードを保存する (Windows 資格情報マネージャー)" />

                <Expander Header="画面" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <ComboBox x:Name="ResolutionBox" Header="解像度" HorizontalAlignment="Stretch" />
                        <ToggleSwitch x:Name="ScalingSwitch" Header="リモートの表示スケールをこの PC に合わせる" IsOn="True" />
                    </StackPanel>
                </Expander>

                <Expander Header="ローカル リソース" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="ClipboardBox" Content="クリップボード (テキスト) を共有する" IsChecked="True" />
                        <CheckBox x:Name="AudioBox" Content="リモートの音声をこの PC で再生する" IsChecked="True" />
                        <CheckBox x:Name="DrivesBox" Content="この PC のドライブをリモートで使用する" />
                        <CheckBox x:Name="WinKeysBox" Content="Windows キーの組み合わせをリモートに送る" IsChecked="True" />
                        <ComboBox x:Name="KeyboardBox" Header="ハードウェア キーボード" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                  ToolTipService.ToolTip="リモートに通知するキーボードの種類。記号キーの配列が合わない場合に変更します。" />
                        <ComboBox x:Name="LayoutBox" Header="リモートに通知するキーボード レイアウト" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                  ToolTipService.ToolTip="Windows サーバーは「自動」のままで英語キーボードに対応します。xrdp (Linux) はレイアウトだけで配列を決めるため、英語キーボードでは「英語 (US)」を選びます。" />
                    </StackPanel>
                </Expander>

                <Expander Header="詳細設定" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <CheckBox x:Name="H264Box" Content="H.264 (AVC444) を使用する" />
                        <CheckBox x:Name="IgnoreCertBox" Content="証明書の検証を行わない (非推奨)" />
                        <TextBox x:Name="ExtraArgsBox" Header="追加の FreeRDP オプション"
                                 PlaceholderText="例: /gateway:g:gw.example.com /microphone"
                                 FontFamily="Consolas" />
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Click="OnConnectClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE703;" FontSize="16" />
                            <TextBlock Text="接続" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenRdpFileClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text=".rdp ファイルを開く" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            </StackPanel>

            <!-- Recent connections -->
            <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="最近の接続" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="NoRecentText" Grid.Row="1" Text="まだ接続履歴はありません。" Opacity="0.6" />
                <ListView x:Name="RecentList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="OnRecentItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConnectionProfile">
                            <Grid Padding="0,8" ColumnSpacing="12" DoubleTapped="OnRecentDoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Summary}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Button ToolTipService.ToolTip="接続" Click="OnRecentConnectClick" Tag="{x:Bind}"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="履歴から削除" Click="OnRecentDeleteClick" Tag="{x:Bind}"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
